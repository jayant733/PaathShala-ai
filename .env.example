# =====================================================================
# PaathShala AI - Root Docker Compose Environment Configuration
# =====================================================================

# Google Gemini API Key (Required for Frontier Cloud LLM & text-embedding-004)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Webhook URL (Optional: For Alertmanager incident alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Local Ollama Inference Base URL (Optional: If running Ollama on host machine)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Environment Mode
ENVIRONMENT=production
